camera:
  # AE exposure ceiling for still captures. AE uses less in daylight automatically,
  # so a high value here does not slow down daytime scanning.
  # With 3s max, each night capture takes ~6s (one warmup + one real frame).
  # Increase scanning_interval_seconds accordingly so the Pi isn't scheduling
  # a new capture before the previous one finishes.
  max_exposure_seconds: 3.0

detection:
  confidence_threshold: 0.5      # minimum server confidence to trigger audio on the Pi
  capture_width: 640
  capture_height: 480
  scanning_interval_seconds: 2.0  # pause between server queries in SCANNING state
  alert_poll_interval_seconds: 1.0 # pause between server queries in ALERT state

# URL of the Moondream2 server (A6000 cluster)
server:
  url: "http://192.168.50.XXX:8000"
  timeout_seconds: 10.0
  max_failures: 5                # consecutive failures before entering offline mode
  retry_delay_seconds: 5.0

clip:
  enabled: true
  clip_dir: data/clips
  max_clips: 50                  # oldest clips pruned once limit is reached
  pre_roll_frames: 3             # frames buffered before detection (prepended to clip)
  max_clip_seconds: 120.0        # hard stop per clip

audio:
  sounds_dir: data/sounds
  # 0.0–1.0: normal attenuation. >1.0: amplify by multiplying samples (clips/saturates at extremes).
  # Values like 3.0–5.0 give noticeably louder output at the cost of distortion.
  volume: 3.0
  alert_interval_seconds: 30.0  # minimum seconds between audio plays while rabbit is present

email:
  # Email is sent by the server, not the Pi. Fill in credentials on both machines.
  enabled: true
  host: smtp.gmail.com
  port: 587
  username: you@gmail.com
  # Use a Gmail App Password, not your account password.
  # Generate one at: https://myaccount.google.com/apppasswords
  password: "xxxx-xxxx-xxxx-xxxx"
  from_addr: you@gmail.com
  to_addr: you@gmail.com
  cooldown_seconds: 300

# Server-side settings (read by server/server.py, ignored by the Pi)
server_app:
  host: "0.0.0.0"
  port: 8000
  device: "cuda:0"
  # model_id and model_revision are set in server/config.py defaults
  detection_prompt: "Is there a rabbit in this image? Reply with only 'yes' or 'no'."
  frames_dir: data/server-frames
  max_frames: 5000

hotspot:
  # If no WiFi IP is obtained within timeout_seconds of boot, create an AP so
  # you can SSH in and fix the network config. Pi address in hotspot mode: 192.168.4.1
  enabled: true
  timeout_seconds: 120
  ssid: "RabbitDetector"
  password: "rabbitdet"  # must be 8+ characters

log_detections: true
log_dir: data/logs
