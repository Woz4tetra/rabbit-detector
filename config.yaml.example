detection:
  model_path: data/models/rabbit_detector.onnx
  confidence_threshold: 0.45
  image_size: 320
  capture_width: 640
  capture_height: 480
  # Camera stream frame rate during ALERT state (fps). Also sets the video output fps.
  frame_rate: 10.0

audio:
  # Directory containing .wav files to play as deterrents.
  # A random file is chosen each time a rabbit is detected.
  sounds_dir: data/sounds
  volume: 0.9

email:
  enabled: true
  host: smtp.gmail.com
  port: 587
  username: you@gmail.com
  # Use a Gmail App Password, not your account password.
  # Generate one at: https://myaccount.google.com/apppasswords
  password: "xxxx-xxxx-xxxx-xxxx"
  from_addr: you@gmail.com
  to_addr: you@gmail.com
  # Minimum seconds between emails to avoid inbox flooding
  cooldown_seconds: 300

storage:
  # Save every inference frame as a JPEG. Images are named by timestamp and tagged
  # _rabbit or _clear. Oldest images are deleted once max_images is reached.
  save_images: false
  image_dir: data/images
  max_images: 1000  # 0 = unlimited

  # Record an MJPEG video for each ALERT event. Video runs at detection.frame_rate.
  save_video: false
  video_dir: data/videos

log_detections: true
log_dir: data/logs
