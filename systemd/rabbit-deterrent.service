[Unit]
Description=Rabbit Detection and Deterrent System
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__PROJECT_ROOT__
ExecStart=__PROJECT_ROOT__/.venv/bin/rabbit-detect
Restart=on-failure
RestartSec=10
SyslogIdentifier=rabbit-deterrent
StandardOutput=journal
StandardError=journal
SupplementaryGroups=video gpio audio

[Install]
WantedBy=multi-user.target
