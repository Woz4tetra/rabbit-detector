#!/bin/bash
set -e

REMOTE_HOST="ben@megamind"
REMOTE_FRAMES="/home/ben/rabbit-detector/data/server-frames/"
LOCAL_FRAMES="/home/ben/rabbit-detector/data/server-frames/"
RSYNC_EXTRA="--ignore-existing"

for arg in "$@"; do
    case "$arg" in
        --all) RSYNC_EXTRA="" ;;
        *) echo "Unknown argument: $arg"; exit 1 ;;
    esac
done

mkdir -p "$LOCAL_FRAMES"

echo "Syncing frames from server..."
rsync --progress -av $RSYNC_EXTRA "$REMOTE_HOST:$REMOTE_FRAMES" "$LOCAL_FRAMES"

echo "Done. Frames synced to $LOCAL_FRAMES"
